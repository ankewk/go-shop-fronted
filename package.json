{
  "name": "gin-ecommerce-frontend",
  "version": "1.0.0",
  "type": "module",
  "description": "Gin微服务电商平台前端 - Vue3 + Vuex",
  "scripts": {
    "dev": "cross-env APP_ENV=dev vite",
    "build": "cross-env APP_ENV=prod vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 3000",
    "dev:h5": "cross-env APP_ENV=dev vite --mode dev",
    "dev:h5:uat": "cross-env APP_ENV=uat vite --mode uat",
    "dev:h5:prod": "cross-env APP_ENV=prod vite --mode prod",
    "build:dev": "cross-env APP_ENV=dev vite build --mode dev",
    "build:uat": "cross-env APP_ENV=uat vite build --mode uat",
    "build:prod": "cross-env APP_ENV=prod vite build --mode prod",
    "deploy:dev": "npm run build:dev && node scripts/deploy.js dev",
    "deploy:uat": "npm run build:uat && node scripts/deploy.js uat",
    "deploy:prod": "npm run build:prod && node scripts/deploy.js prod",
    "env:switch": "node scripts/env-switch.js",
    "env:info": "node scripts/env-info.js",
    "env:create": "node scripts/create-env.js"
  },
  "dependencies": {
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "vuex": "^4.1.0",
    "axios": "^1.6.5",
    "element-plus": "^2.4.4",
    "@element-plus/icons-vue": "^2.3.1",
    "@dcloudio/uni-app": "3.0.0-4020420240930001",
    "@dcloudio/uni-app-plus": "3.0.0-4020420240930001",
    "@dcloudio/uni-components": "3.0.0-4020420240930001",
    "@dcloudio/uni-h5": "3.0.0-4020420240930001",
    "@dcloudio/uni-mp-alipay": "3.0.0-4020420240930001",
    "@dcloudio/uni-mp-baidu": "3.0.0-4020420240930001",
    "@dcloudio/uni-mp-qq": "3.0.0-4020420240930001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-4020420240930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4020420240930001",
    "@dcloudio/uni-quickapp-webview": "3.0.0-4020420240930001"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "vite": "^5.0.11",
    "sass": "^1.70.0",
    "unplugin-auto-import": "^0.17.3",
    "unplugin-vue-components": "^0.26.0",
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-4020420240930001",
    "@dcloudio/uni-cli-shared": "3.0.0-4020420240930001",
    "@dcloudio/webpack-uni-mp-loader": "3.0.0-4020420240930001",
    "@types/wechat-miniprogram": "^3.4.7",
    "cross-env": "^7.0.3",
    "postcss-comment": "^2.0.0"
  },
  "keywords": [
    "vue3",
    "vuex",
    "vite",
    "ecommerce",
    "microservices",
    "gin",
    "frontend"
  ],
  "author": "Gin Ecommerce Team",
  "license": "MIT"
}